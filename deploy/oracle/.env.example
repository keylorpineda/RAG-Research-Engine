# Copy to .env next to compose.yml. Never commit the filled-in file.

# Public name of the API. Without a domain: api.<public-ip>.sslip.io
API_DOMAIN=api.203.0.113.10.sslip.io
POSTGRES_PASSWORD=change-me-to-a-long-random-string

GROQ_API_KEY=
# Or answer with a local model on the VM (docker compose --profile local-llm up -d):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct

# Embeddings. "local" runs on the VM (no key, no quota); "cohere" is the best measured quality.
# Build with EXTRAS=none when using Cohere only.
EMBEDDING_PROVIDER=local
EXTRAS=local
# COHERE_API_KEY=
# RERANK_PROVIDER=cohere
# COHERE_TOKENS_PER_MINUTE=90000
# COHERE_EMBED_REQUESTS_PER_MINUTE=90
# COHERE_RERANK_REQUESTS_PER_MINUTE=9

# Public demo: preloaded PEPs, no uploads, limits on paid or capped providers.
UPLOADS_ENABLED=false
# DAILY_QUESTION_LIMIT=15
QUESTIONS_PER_CLIENT_PER_HOUR=10
ANSWER_CACHE_SIZE=256
# Only for a browser app on another origin that calls the API directly (Vercel rewrites do not need it).
# CORS_ORIGINS=https://research-engine.vercel.app
