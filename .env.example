# Postgres connection used by the API (docker compose overrides the host).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ragdb

# Groq generates the answers.
GROQ_API_KEY=changeme

# Embeddings: "cohere" (needs COHERE_API_KEY) or "local" (fastembed on the CPU, no key).
EMBEDDING_PROVIDER=cohere
COHERE_API_KEY=changeme

UPLOADS_DIR=uploads
INGESTION_POLL_INTERVAL_MS=2000
