# Postgres connection used by the API (docker compose overrides the host).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ragdb

# Groq generates the answers, Cohere embeds the text.
GROQ_API_KEY=changeme
COHERE_API_KEY=changeme

UPLOADS_DIR=uploads
INGESTION_POLL_INTERVAL_MS=2000
