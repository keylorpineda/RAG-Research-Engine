# Copy to .env and fill in GROQ_API_KEY. Everything else has a working default.

# --- Required ------------------------------------------------------------------------------
# Groq writes the answers (free key at https://console.groq.com/keys). Without it the engine
# still retrieves and abstains, but cannot answer.
GROQ_API_KEY=changeme

# --- Embeddings ----------------------------------------------------------------------------
# "local": multilingual ONNX model on the CPU, no key, downloaded once (about 220 MB).
# "cohere": Cohere embed-multilingual-v3.0, needs COHERE_API_KEY. Switching providers changes
# the vector size: run the migrations on a fresh database and re-ingest the documents.
EMBEDDING_PROVIDER=local
# COHERE_API_KEY=
# Cohere trial keys allow 100,000 tokens per minute; this keeps ingestion under the limit.
# COHERE_TOKENS_PER_MINUTE=90000

# Optional second stage: "cohere" reranks the top RERANK_CANDIDATES chunks (needs COHERE_API_KEY).
RERANK_PROVIDER=none
# Cohere trial keys allow 10 rerank calls per minute.
# COHERE_RERANK_REQUESTS_PER_MINUTE=10

# Override the calibrated abstention threshold (0.55 for the local model).
# MIN_SIMILARITY=0.55

# --- Running outside docker compose --------------------------------------------------------
# Compose sets these for its containers; they matter when you run uvicorn or the worker yourself.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ragdb
UPLOADS_DIR=uploads
# MODEL_CACHE_DIR=.cache/models

# Ingestion runs in `python -m app.worker`. Set EMBEDDED_WORKER=true to run one inside the API.
EMBEDDED_WORKER=false
JOB_MAX_ATTEMPTS=5
