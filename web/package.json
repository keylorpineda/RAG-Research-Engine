{
  "name": "research-engine-web",
  "version": "2.3.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "benchmarks": "node scripts/benchmarks.mjs && prettier --write src/app/pages/benchmarks/benchmarks.data.ts"
  },
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
